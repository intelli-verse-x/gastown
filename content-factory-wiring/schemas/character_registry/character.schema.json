{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contentx.io/schemas/character_registry/character.schema.json",
  "title": "Character Canonical Identity",
  "type": "object",
  "required": ["char_id", "name", "char_type", "outfit_states", "locked", "signature"],
  "properties": {
    "char_id":        { "type": "string", "pattern": "^[a-z0-9_-]{2,32}$" },
    "name":           { "type": "string", "minLength": 1, "maxLength": 64 },
    "char_type":      { "enum": ["human_avatar", "animated_2d", "animated_3d", "voice_only", "mascot"] },
    "voice_id":       { "type": ["string", "null"] },
    "aliases":        { "type": "array", "items": { "type": "string" } },
    "outfit_states": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["state_id", "description"],
        "properties": {
          "state_id":       { "type": "string", "pattern": "^[a-z0-9_-]{1,32}$" },
          "description":    { "type": "string" },
          "primary_colors": { "type": "array", "items": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" } },
          "histogram":      { "type": "array", "items": { "type": "number" } }
        }
      }
    },
    "appearance_notes":  { "type": "string" },
    "locked":            { "type": "boolean" },
    "locked_by":         { "type": "string" },
    "locked_at":         { "type": "string" },
    "locked_until":      { "type": ["string", "null"] },
    "embedding_count":   { "type": "integer", "minimum": 0 },
    "embedding_backend": { "enum": ["insightface", "face_recognition", "phash"] },
    "signature":         { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
